<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dashboard_blue"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="返回"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="创建派工单"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/DispatchSectionCard"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="19dp"
                            android:background="@color/dashboard_blue" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:text="当前项目"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/switch_project_button"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:drawableEnd="@drawable/ic_next"
                            android:drawablePadding="2dp"
                            android:gravity="center"
                            android:paddingHorizontal="4dp"
                            android:text="切换项目"
                            android:textColor="@color/dashboard_blue"
                            android:textSize="13sp"
                            app:drawableTint="@color/dashboard_blue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/project_cover"
                            android:layout_width="112dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_dispatch_cover"
                            android:clipToOutline="true"
                            android:contentDescription="项目封面"
                            android:padding="18dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_project" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/project_name_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="正在加载项目"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/project_manager_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="项目经理：--"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/project_stage_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="项目阶段：--"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/DispatchSectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="19dp" android:background="@color/dashboard_blue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="基础信息"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DispatchCompactInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:hint="派工标题 *"
                            app:counterEnabled="true"
                            app:counterMaxLength="128">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/title_input"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:maxLength="128"
                                android:singleLine="true"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DispatchCompactInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:hint="施工位置 *">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/location_input"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:maxLength="255"
                                android:singleLine="true"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="任务类型"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/dispatch_type_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:checkedButton="@id/type_repair_button"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/type_repair_button" style="@style/DispatchToggleButton" android:text="维修" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/type_install_button" style="@style/DispatchToggleButton" android:text="安装" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/type_clean_button" style="@style/DispatchToggleButton" android:text="清理" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/type_rectification_button" style="@style/DispatchToggleButton" android:text="整改" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/type_inspection_button" style="@style/DispatchToggleButton" android:text="巡检" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="优先级"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/priority_group"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:checkedButton="@id/priority_normal_button"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/priority_normal_button" style="@style/DispatchToggleButton" android:text="普通" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/priority_urgent_button" style="@style/DispatchToggleButton" android:text="紧急" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/priority_major_button" style="@style/DispatchToggleButton" android:text="重大" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/DispatchCompactInput"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="截止时间 *"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconMode="custom">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/deadline_input"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="请选择日期和时间"
                            android:inputType="none"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/DispatchSectionCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="19dp" android:background="@color/dashboard_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="派工对象" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="班组 *">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/team_spinner"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:inputType="none"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dispatch_count"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">
                            <TextView
                                android:id="@+id/team_leader_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_user"
                                android:drawablePadding="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="班组长：--"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                app:drawableTint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/DispatchSectionCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="19dp" android:background="@color/dashboard_blue" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="任务要求" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/auto_fill_requirement_button"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="一键生成"
                            android:textAllCaps="false"
                            android:textColor="@color/dashboard_blue"
                            android:textSize="12sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/dashboard_blue" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DispatchCompactInput"
                            android:layout_width="match_parent"
                            android:layout_height="118dp"
                            android:hint="任务内容 *"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/content_input"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="top|start"
                                android:maxLength="500"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DispatchCompactInput"
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:layout_marginTop="8dp"
                            android:hint="施工要求"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/construction_requirement_input"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="top|start"
                                android:maxLength="500"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DispatchCompactInput"
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:layout_marginTop="8dp"
                            android:hint="安全注意事项"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/safety_notice_input"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="top|start"
                                android:maxLength="500"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/DispatchSectionCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="19dp" android:background="@color/dashboard_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="验收标准" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/completion_photo_required_switch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="必须上传完工照片"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            app:thumbTint="@color/dispatch_switch_thumb"
                            app:trackTint="@color/dispatch_switch_track" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/before_photo_required_switch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="需要施工前照片"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            app:thumbTint="@color/dispatch_switch_thumb"
                            app:trackTint="@color/dispatch_switch_track" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="最少完工照片数量"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:layout_width="132dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_dispatch_count"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/completion_minus_button" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="−" android:textColor="@color/text_primary" android:textSize="20sp" />
                            <TextView android:id="@+id/completion_min_photo_input" android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center" android:text="3" android:textColor="@color/text_primary" android:textSize="14sp" />
                            <TextView android:id="@+id/completion_plus_button" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="＋" android:textColor="@color/text_primary" android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/DispatchCompactInput"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="7dp"
                        android:hint="验收说明"
                        app:counterEnabled="true"
                        app:counterMaxLength="300">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/acceptance_standard_input"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="top|start"
                            android:maxLength="300"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/DispatchSectionCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="19dp" android:background="@color/dashboard_blue" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="过程检查要求" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/process_check_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="启用"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            app:thumbTint="@color/dispatch_switch_thumb"
                            app:trackTint="@color/dispatch_switch_track" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/process_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="检查方式" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/process_mode_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:checkedButton="@id/process_mode_node_button"
                            app:selectionRequired="true"
                            app:singleSelection="true">
                            <com.google.android.material.button.MaterialButton android:id="@+id/process_mode_node_button" style="@style/DispatchToggleButton" android:text="按节点检查" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/process_mode_day_button" style="@style/DispatchToggleButton" android:text="按天检查" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/process_mode_manual_button" style="@style/DispatchToggleButton" android:text="手动抽查" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="检查节点" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/process_node_opening" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:padding="0dp" android:text="开工确认" android:textSize="11sp" />
                            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/process_node_middle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:padding="0dp" android:text="施工中检查" android:textSize="11sp" />
                            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/process_node_hidden" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:padding="0dp" android:text="隐蔽前检查" android:textSize="11sp" />
                            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/process_node_final" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:padding="0dp" android:text="完工前复核" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="过程照片要求：每次至少上传" android:textColor="@color/text_primary" android:textSize="12sp" />
                            <LinearLayout android:layout_width="112dp" android:layout_height="36dp" android:background="@drawable/bg_dispatch_count" android:gravity="center" android:orientation="horizontal">
                                <TextView android:id="@+id/process_minus_button" android:layout_width="34dp" android:layout_height="match_parent" android:gravity="center" android:text="−" android:textSize="19sp" />
                                <TextView android:id="@+id/process_min_photo_input" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="2" android:textColor="@color/text_primary" android:textSize="14sp" />
                                <TextView android:id="@+id/process_plus_button" android:layout_width="34dp" android:layout_height="match_parent" android:gravity="center" android:text="＋" android:textSize="17sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/process_require_location_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:checked="true"
                            android:text="过程上报必须带定位"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            app:thumbTint="@color/dispatch_switch_thumb"
                            app:trackTint="@color/dispatch_switch_track" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/manager_spot_check_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="允许项目经理抽查"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            app:thumbTint="@color/dispatch_switch_thumb"
                            app:trackTint="@color/dispatch_switch_track" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/DispatchCompactInput"
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_marginTop="5dp"
                            android:hint="过程检查说明"
                            app:counterEnabled="true"
                            app:counterMaxLength="300">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/process_description_input"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="top|start"
                                android:maxLength="300"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/DispatchSectionCard"
                android:layout_marginBottom="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="19dp" android:background="@color/dashboard_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="附件" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/drawing_attachment_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dispatch_attachment"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="图纸" android:src="@drawable/ic_doc" app:tint="#315EF5" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="图纸" android:textColor="@color/text_primary" android:textSize="12sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="上传图纸文件" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/notice_attachment_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dispatch_attachment"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="整改通知" android:src="@drawable/ic_alert" app:tint="#FF6B4A" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="整改通知" android:textColor="@color/text_primary" android:textSize="12sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="上传通知文件" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/photo_attachment_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dispatch_attachment"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="现场照片" android:src="@drawable/ic_camera" app:tint="#20B34B" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="现场照片" android:textColor="@color/text_primary" android:textSize="12sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="上传相关照片" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_draft_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:text="保存草稿"
            android:textAllCaps="false"
            android:textColor="@color/dashboard_blue"
            android:textSize="15sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/dashboard_blue" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="确认派工"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="@color/dashboard_blue"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
