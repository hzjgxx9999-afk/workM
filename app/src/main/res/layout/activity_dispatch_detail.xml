<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/dashboard_blue"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/back_button" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回" android:padding="13dp" android:src="@drawable/ic_arrow_back" android:tint="@android:color/white" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="派工验收" android:textColor="@android:color/white" android:textSize="21sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/menu_button" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="更多操作" android:src="@drawable/ic_more_vert" android:tint="@android:color/white" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeColor="#E5EAF1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:id="@+id/status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_soft_purple" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:textColor="#7C3AED" android:textStyle="bold" />
                        <TextView android:id="@+id/title_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#101828" android:textSize="19sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/phase_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:textColor="#7C3AED" android:textSize="13sp" />
                    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:columnCount="2" android:useDefaultMargins="true">
                        <TextView android:id="@+id/dispatch_no_text" style="@style/DispatchMetaText" />
                        <TextView android:id="@+id/leader_text" style="@style/DispatchMetaText" />
                        <TextView android:id="@+id/project_text" style="@style/DispatchMetaText" />
                        <TextView android:id="@+id/location_text" style="@style/DispatchMetaText" />
                        <TextView android:id="@+id/team_text" style="@style/DispatchMetaText" />
                        <TextView android:id="@+id/deadline_text" style="@style/DispatchMetaText" />
                    </GridLayout>
                    <LinearLayout android:id="@+id/spot_check_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_warning_orange_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp" android:visibility="gone">
                        <TextView android:id="@+id/spot_check_status_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#B54708" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/spot_check_action" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minHeight="40dp" android:text="查看抽查" android:textColor="#086DFF" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E5EAF1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/DispatchSectionTitle" android:text="班组汇总" />
                    <TextView android:id="@+id/summary_time_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#667085" android:textSize="13sp" />
                    <TextView android:id="@+id/summary_content_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textColor="#344054" android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E5EAF1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/DispatchSectionTitle" android:text="工人处理记录" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/worker_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E5EAF1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/DispatchSectionTitle" android:text="过程检查记录" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/process_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E5EAF1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/DispatchSectionTitle" android:text="照片证据" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/evidence_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/acceptance_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E5EAF1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/DispatchSectionTitle" android:text="验收意见" />
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:counterEnabled="true" app:counterMaxLength="300" app:hintEnabled="false">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/acceptance_input" android:layout_width="match_parent" android:layout_height="92dp" android:gravity="top|start" android:hint="请输入验收意见（通过时至少10个字）" android:inputType="textMultiLine" android:maxLength="300" android:padding="12dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:id="@+id/action_bar" android:layout_width="match_parent" android:layout_height="72dp" android:background="@android:color/white" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="14dp" android:paddingVertical="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/reject_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="驳回整改" android:textColor="#F04438" app:backgroundTint="@android:color/white" app:cornerRadius="8dp" app:strokeColor="#F04438" app:strokeWidth="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/approve_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="验收通过" android:textColor="@android:color/white" app:backgroundTint="#12B76A" app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
