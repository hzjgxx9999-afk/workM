<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/material_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:background="@drawable/bg_bracelet_top"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <ImageButton
                        android:id="@+id/back_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_back"
                        android:tint="@color/white" />

                    <TextView
                        android:id="@+id/title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="材料资源"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/search_button"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            android:src="@drawable/ic_search"
                            android:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/notification_button"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            android:src="@drawable/ic_bell"
                            android:tint="@color/white" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/project_switch_text"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/white"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:text="中建 · 未来城二期项目  ˅"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="238dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_blue_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/overview_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="材料资源概览                                      今日"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:columnCount="2">

                    <TextView
                        android:id="@+id/material_count_text"
                        style="@style/BraceletOverviewValue"
                        android:text="材料种类\n128种" />

                    <TextView
                        android:id="@+id/stock_total_text"
                        style="@style/BraceletOverviewValue"
                        android:text="库存总量\n28,456吨" />

                    <TextView
                        android:id="@+id/today_inbound_text"
                        style="@style/BraceletOverviewValue"
                        android:text="今日入库\n356吨" />

                    <TextView
                        android:id="@+id/today_outbound_text"
                        style="@style/BraceletOverviewValue"
                        android:text="今日出库\n287吨" />
                </GridLayout>

                <TextView
                    android:id="@+id/low_stock_text"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip_blue"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="低库存预警                                      8种"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="材料分类"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:columnCount="2">

                <TextView
                    android:id="@+id/material_category_1"
                    style="@style/ResourceCategoryCard"
                    android:drawableTop="@drawable/ic_material"
                    android:text="钢筋\n12,456 吨" />

                <TextView
                    android:id="@+id/material_category_2"
                    style="@style/ResourceCategoryCard"
                    android:drawableTop="@drawable/ic_doc"
                    android:text="水泥\n5,326 吨" />

                <TextView
                    android:id="@+id/material_category_3"
                    style="@style/ResourceCategoryCard"
                    android:drawableTop="@drawable/ic_export"
                    android:text="模板\n2,180 张" />

                <TextView
                    android:id="@+id/material_category_4"
                    style="@style/ResourceCategoryCard"
                    android:drawableTop="@drawable/ic_alert"
                    android:text="安全帽\n1,856 顶" />

                <TextView
                    android:id="@+id/material_category_5"
                    style="@style/ResourceCategoryCard"
                    android:drawableTop="@drawable/ic_workbench"
                    android:text="脚手架\n3,218 套" />

                <TextView
                    android:id="@+id/material_category_6"
                    style="@style/ResourceCategoryCard"
                    android:drawableTop="@drawable/ic_project"
                    android:text="机械设备\n86 台" />
            </GridLayout>

            <TextView
                android:id="@+id/material_list_entry"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_round_blue"
                android:gravity="center"
                android:text="查看材料明细"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/material_report_entry"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_outline_blue"
                android:gravity="center"
                android:text="查看资源报表与导出"
                android:textColor="@color/dashboard_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
