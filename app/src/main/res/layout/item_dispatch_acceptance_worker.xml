<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/name_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#101828" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/result_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:textColor="#475467" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/photo_count_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#086DFF" android:textSize="13sp" />
</LinearLayout>
