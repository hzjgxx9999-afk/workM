<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_stroke" android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/dispatch_priority" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_orange_soft" android:paddingHorizontal="7dp" android:paddingVertical="4dp"
            android:textColor="@color/warning" android:textSize="11sp" />
        <TextView android:id="@+id/dispatch_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1" android:maxLines="2"
            android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/dispatch_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_blue" android:paddingHorizontal="7dp" android:paddingVertical="4dp"
            android:textColor="@color/dashboard_blue" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/dispatch_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/dispatch_deadline" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
</LinearLayout>
