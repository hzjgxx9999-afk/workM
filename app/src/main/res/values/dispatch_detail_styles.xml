<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DispatchMetaText">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item><item name="android:ellipsize">end</item><item name="android:maxLines">2</item>
        <item name="android:minHeight">34dp</item><item name="android:textColor">#475467</item><item name="android:textSize">13sp</item>
    </style>
    <style name="DispatchSectionTitle">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#101828</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="DispatchDetailCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">#E5EAF1</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="DispatchDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#344054</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
